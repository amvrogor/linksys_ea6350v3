config homeusb 'settings'
	option enabled '1'

	# Точка монтирования
	option mountpoint '/mnt/sda'

	# Папка с медиа
	option media_dir '/mnt/sda/Archive'

	# Каталог базы MiniDLNA
	option dlna_db '/mnt/sda/.dlna'

	# Общий доступ Samba
	option samba_enabled '1'

	# MiniDLNA
	option dlna_enabled '1'

	# FTP
	option ftp_enabled '1'

	# Имя сетевого ресурса
	option share_name 'Antenna-Head'

	# Имя DLNA
	option dlna_name 'Linksys EA6350'

	# Автомонтирование
	option automount '1'

	# Безопасное извлечение
	option safe_remove '1'