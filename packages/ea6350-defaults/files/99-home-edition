#!/bin/sh

# Имя роутера
uci set system.@system[0].hostname='Linksys-EA6350'

# Wi-Fi
uci set wireless.default_radio0.ssid='Linksys_EA6350'
uci set wireless.default_radio0.key='root'
uci set wireless.default_radio0.encryption='psk2'

# Включить радио
uci set wireless.radio0.disabled='0'
uci set wireless.radio1.disabled='0'

uci commit system
uci commit wireless

exit 0