#!/bin/sh
# Safe dual-firmware manager for Linksys EA6350v3.
# v1.0.1: safer image validation and real slot reboot.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
BOARD_EXPECTED="linksys,ea6350v3"
KERNEL_SIZE_HEX="02800000"
ROOTFS_OFFSET_HEX="00300000"
FIT_MAGIC="d00dfeed"
UBI_MAGIC="55424923"

_die() { echo "ERROR: $*" >&2; return 1; }

board_name() {
	[ -r /tmp/sysinfo/board_name ] && { cat /tmp/sysinfo/board_name; return; }
	ubus call system board 2>/dev/null |
		sed -n 's/.*"board_name": *"\([^"]*\)".*/\1/p' | head -n1
}

current_slot() { fw_printenv -n boot_part 2>/dev/null; }
slot_kernel() { [ "$1" = 1 ] && echo kernel || echo alt_kernel; }
slot_rootfs() { [ "$1" = 1 ] && echo rootfs || echo alt_rootfs; }

check_device() {
	[ "$(board_name)" = "$BOARD_EXPECTED" ] || _die "Unsupported board: $(board_name)"
	command -v fw_printenv >/dev/null || _die "fw_printenv not found"
	command -v fw_setenv >/dev/null || _die "fw_setenv not found"
	command -v mtd >/dev/null || _die "mtd not found"
	command -v hexdump >/dev/null || _die "hexdump not found"
}

mtd_size_hex() {
	label="$1"
	awk -v n="$label" '$0 ~ "\\\"" n "\\\"" {print $2; exit}' /proc/mtd 2>/dev/null
}

check_layout() {
	k1="$(mtd_size_hex kernel)"
	k2="$(mtd_size_hex alt_kernel)"
	r1="$(mtd_size_hex rootfs)"
	r2="$(mtd_size_hex alt_rootfs)"
	[ "$k1" = "$KERNEL_SIZE_HEX" ] || _die "Unexpected kernel partition size: ${k1:-missing}"
	[ "$k2" = "$KERNEL_SIZE_HEX" ] || _die "Unexpected alt_kernel partition size: ${k2:-missing}"
	[ -n "$r1" ] && [ -n "$r2" ] || _die "Expected rootfs/alt_rootfs partitions were not found"
}

slot_status() {
	s="$1"; k="$(slot_kernel "$s")"
	ks="$(mtd -l 1048576 dump "$k" 2>/dev/null | strings 2>/dev/null | head -200)"
	if echo "$ks" | grep -q 'ARM Linksys Linux-3\.14\.43'; then
		echo OEM; return
	fi
	if echo "$ks" | grep -Eq 'OpenWrt|Linux version 6\.|Linux version 5\.|Linux version 4\.'; then
		echo OpenWrt; return
	fi
	echo Unknown
}

hex4_at() {
	img="$1"; off="$2"
	dd if="$img" bs=1 skip=$((off)) count=4 2>/dev/null | hexdump -ve '1/1 "%02x"'
}

validate_image() {
	img="$1"
	[ -f "$img" ] || _die "Image not found: $img"
	[ -s "$img" ] || _die "Image is empty: $img"
	case "$(basename "$img")" in
		*linksys_ea6350v3*squashfs-factory.bin) ;;
		*) _die "Only Linksys EA6350v3 squashfs-factory.bin is accepted" ;;
	esac
	sz="$(wc -c < "$img" 2>/dev/null)"
	[ "$sz" -gt 3145728 ] || _die "Factory image is too small: $sz bytes"
	[ "$sz" -le $((16#${KERNEL_SIZE_HEX})) ] || _die "Factory image is larger than the EA6350v3 firmware slot"
	fit="$(hex4_at "$img" 0)"	
	[ "$fit" = "$FIT_MAGIC" ] || _die "Image does not start with a FIT header (got $fit)"
	ubi="$(hex4_at "$img" $((16#$ROOTFS_OFFSET_HEX)))"
	[ "$ubi" = "$UBI_MAGIC" ] || _die "Image has no UBI header at rootfs offset 0x$ROOTFS_OFFSET_HEX (got $ubi)"
}

do_switch() {
	check_device || return 1
	check_layout || return 1
	target="$1"
	case "$target" in 1|2) ;; *) _die "Target slot must be 1 or 2"; return 1;; esac
	cur="$(current_slot)"
	[ "$cur" = 1 ] || [ "$cur" = 2 ] || { _die "Invalid current boot_part: $cur"; return 1; }
	[ "$cur" != "$target" ] || { _die "Slot $target is already active"; return 1; }
	fw_setenv boot_part "$target" || return 1
	[ "$(current_slot)" = "$target" ] || { _die "boot_part verification failed"; return 1; }
	echo "Boot slot changed from $cur to $target. Rebooting..."
	sync
	reboot
}

do_flash() {
	check_device || return 1
	check_layout || return 1
	img="$1"; target="$2"; allow_oem="$3"
	validate_image "$img" || return 1
	cur="$(current_slot)"
	[ "$cur" = 1 ] || [ "$cur" = 2 ] || { _die "Invalid current boot_part: $cur"; return 1; }
	[ "$target" = 1 ] || [ "$target" = 2 ] || { _die "Invalid target slot: $target"; return 1; }
	[ "$target" != "$cur" ] || { _die "Refusing to flash active slot $cur"; return 1; }
	state="$(slot_status "$target")"
	if [ "$state" = OEM ] && [ "$allow_oem" != 1 ]; then
		_die "Target slot $target contains OEM. OEM overwrite is disabled."
		return 2
	fi
	kpart="$(slot_kernel "$target")"
	echo "Current slot : $cur"
	echo "Target slot  : $target"
	echo "Target state : $state"
	echo "Image        : $img"
	echo "Writing      : $kpart (physical 40 MiB slot)"
	echo
	echo "Only the inactive slot will be written."
	echo "The active slot $cur will not be touched."
	# The EA6350v3 factory image is a combined image: FIT kernel followed by
	# the UBI rootfs. The kernel MTD partition spans the complete 40 MiB slot
	# and physically overlaps the rootfs partition, so writing the combined
	# factory image to kernel/alt_kernel updates the complete selected slot.
	mtd -e "$kpart" write "$img" "$kpart" || {
		_die "MTD write failed; boot selection was not changed"
		return 1
	}
	head="$(mtd -l 4 dump "$kpart" 2>/dev/null | hexdump -ve '1/1 "%02x"')"
	ubi="$(mtd -o 0x$ROOTFS_OFFSET_HEX -l 4 dump "$kpart" 2>/dev/null | hexdump -ve '1/1 "%02x"')"
	[ "$head" = "$FIT_MAGIC" ] || { _die "Post-write FIT header verification failed; NOT switching boot slot"; return 1; }
	[ "$ubi" = "$UBI_MAGIC" ] || { _die "Post-write UBI header verification failed; NOT switching boot slot"; return 1; }
	echo "Image written and verified successfully in slot $target."
	echo "Boot slot remains $cur. Switch/reboot separately after verification."
}

status_json() {
	check_device || return 1
	check_layout || return 1
	cur="$(current_slot)"; s1="$(slot_status 1)"; s2="$(slot_status 2)"
	kernsize="$(fw_printenv -n kernsize 2>/dev/null)"; [ -n "$kernsize" ] || kernsize=unknown
	printf '{"model":"Linksys EA6350v3","board":"%s","current_slot":%s,"kernsize":"%s","slot1":"%s","slot2":"%s"}\n' "$(board_name)" "$cur" "$kernsize" "$s1" "$s2"
}

case "$1" in
	status) status_json ;;
	switch) do_switch "$2" ;;
	flash) do_flash "$2" "$3" "$4" ;;
	*)
		echo "Usage:"
		echo "  $0 status"
		echo "  $0 switch <1|2>"
		echo "  $0 flash <factory-image> <target-slot> <allow-oem-1|0>"
		exit 2
		;;
esac
