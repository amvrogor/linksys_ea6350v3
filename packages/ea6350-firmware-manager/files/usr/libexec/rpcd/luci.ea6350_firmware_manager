#!/bin/sh

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | sed ':a;N;$!ba;s/\n/\\n/g'
}

case "$1" in
list)
	echo '{"status":{"read":true},"switch":{"write":true},"flash":{"write":true}}'
	;;
call)
	case "$2" in
	status)
		/usr/sbin/ea6350-firmware-manager status
		;;
	switch)
		read -r input
		slot="$(echo "$input" | jsonfilter -e '@.slot' 2>/dev/null)"
		out="$(/usr/sbin/ea6350-firmware-manager switch "$slot" 2>&1)"
		rc=$?
		if [ "$rc" -eq 0 ]; then
			printf '{"result":"ok","message":"%s"}\n' "$(json_escape "$out")"
		else
			printf '{"error":"%s","code":%s}\n' "$(json_escape "$out")" "$rc"
		fi
		;;
	flash)
		read -r input
		image="$(echo "$input" | jsonfilter -e '@.image' 2>/dev/null)"
		slot="$(echo "$input" | jsonfilter -e '@.slot' 2>/dev/null)"
		allow="$(echo "$input" | jsonfilter -e '@.allow_oem' 2>/dev/null)"
		out="$(/usr/sbin/ea6350-firmware-manager flash "$image" "$slot" "$allow" 2>&1)"
		rc=$?
		if [ "$rc" -eq 0 ]; then
			printf '{"result":"ok","message":"%s"}\n' "$(json_escape "$out")"
		else
			printf '{"error":"%s","code":%s}\n' "$(json_escape "$out")" "$rc"
		fi
		;;
	esac
	;;
esac
