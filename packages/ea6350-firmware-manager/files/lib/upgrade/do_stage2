#!/bin/sh

#
# Linksys EA6350v3 Firmware Manager
# Version 1.0.17
#
# Custom OpenWrt sysupgrade stage 2.
#
# This file is executed from the OpenWrt RAMFS environment.
#
# For normal upgrades:
#
#       platform_do_upgrade "$IMAGE"
#
# is used exactly as in standard OpenWrt.
#
# For:
#
#       sysupgrade -s
#
# procd exports:
#
#       UPGRADE_OPT_USE_CURR_PART=1
#
# On EA6350v3 the native linksys.sh implementation always
# switches the target to the inactive slot.
#
# Therefore current-slot mode deliberately bypasses
# platform_do_upgrade() and calls nand_do_upgrade() with
# explicitly selected CURRENT partitions.
#


. /lib/functions.sh

include /lib/upgrade


v "Performing system upgrade..."


#
# ============================================================
# CURRENT-SLOT UPGRADE
# ============================================================
#
if [ "$UPGRADE_OPT_USE_CURR_PART" = "1" ]; then

	echo
	echo "========================================"
	echo " EA6350v3 CURRENT-SLOT UPGRADE"
	echo "========================================"
	echo

	#
	# Verify board.
	#
	BOARD="$(board_name)"

	[ "$BOARD" = "linksys,ea6350v3" ] || {
		echo "ERROR: current-slot upgrade is supported only"
		echo "       on Linksys EA6350v3"
		exit 1
	}


	#
	# Verify image.
	#
	[ -n "$IMAGE" ] || {
		echo "ERROR: firmware image is not specified"
		exit 1
	}

	[ -f "$IMAGE" ] || {
		echo "ERROR: firmware image does not exist:"
		echo "       $IMAGE"
		exit 1
	}


	#
	# Current-slot mode is intended for OpenWrt
	# sysupgrade images.
	#
	# 0x73797375 = "sysu"
	#
	magic_long="$(get_magic_long "$IMAGE")"

	if [ "$magic_long" != "73797375" ]; then
		echo "ERROR: current-slot upgrade requires"
		echo "       an OpenWrt sysupgrade image"
		echo
		echo "Image magic: $magic_long"
		exit 1
	fi


	#
	# Determine currently active firmware slot.
	#
	boot_part="$(fw_printenv -n boot_part 2>/dev/null | \
		head -n1)"


	case "$boot_part" in

		1)

			#
			# CURRENT SLOT = primary
			#
			CI_KERNPART="kernel"
			CI_UBIPART="rootfs"
			CI_ROOTPART="rootfs"

			;;

		2)

			#
			# CURRENT SLOT = alternate
			#
			CI_KERNPART="alt_kernel"
			CI_UBIPART="alt_rootfs"
			CI_ROOTPART="alt_rootfs"

			;;

		*)

			echo "ERROR: cannot determine current boot_part:"
			echo "       $boot_part"
			exit 1

			;;

	esac


	#
	# Export variables used by nand.sh.
	#
	export CI_KERNPART
	export CI_UBIPART
	export CI_ROOTPART


	#
	# Display final target.
	#
	echo "Board: $BOARD"
	echo "Current boot_part: $boot_part"
	echo
	echo "CURRENT kernel partition:"
	echo "  $CI_KERNPART"
	echo
	echo "CURRENT UBI partition:"
	echo "  $CI_UBIPART"
	echo
	echo "CURRENT rootfs volume:"
	echo "  $CI_ROOTPART"
	echo
	echo "Firmware image:"
	echo "  $IMAGE"
	echo

	echo "========================================"
	echo " WARNING"
	echo "========================================"
	echo
	echo "The CURRENT firmware slot will be erased"
	echo "and replaced by the new OpenWrt image."
	echo
	echo "boot_part will NOT be changed."
	echo
	echo "The device will reboot after the upgrade."
	echo
	echo "========================================"
	echo


	#
	# Synchronize filesystem writes before touching NAND.
	#
	sync


	#
	# IMPORTANT:
	#
	# Do NOT call:
	#
	#     platform_do_upgrade "$IMAGE"
	#
	# because linksys.sh would execute:
	#
	#     linksys_get_target_firmware()
	#
	# which deliberately selects the INACTIVE slot.
	#
	# Instead call nand_do_upgrade() directly with our
	# explicitly selected CURRENT CI_* variables.
	#
	echo "Starting NAND upgrade of CURRENT slot..."
	echo


	nand_do_upgrade "$IMAGE"


	#
	# Normally nand_do_upgrade() does not return here:
	#
	#     nand_do_upgrade_success()
	#         |
	#         +-- restore configuration
	#         +-- sync
	#         +-- reboot
	#
	echo
	echo "ERROR: nand_do_upgrade returned unexpectedly"
	exit 1

fi


#
# ============================================================
# NORMAL / INACTIVE-SLOT UPGRADE
# ============================================================
#
# This is the normal OpenWrt behaviour.
#
# On EA6350v3 platform_do_upgrade() calls linksys.sh, which
# selects the opposite firmware slot.
#


if type 'platform_do_upgrade' >/dev/null 2>/dev/null; then

	platform_do_upgrade "$IMAGE"

else

	default_do_upgrade "$IMAGE"

fi


#
# Restore configuration if requested by normal sysupgrade.
#
if [ -n "$UPGRADE_BACKUP" ] && \
	type 'platform_copy_config' >/dev/null 2>/dev/null; then

	platform_copy_config

fi


v "Upgrade completed"

sleep 1


v "Rebooting system..."

umount -a

reboot -f

sleep 5

echo b 2>/dev/null >/proc/sysrq-trigger