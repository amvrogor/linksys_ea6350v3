#!/bin/sh

#
# Linksys EA6350v3 / OpenWrt 25.12
#
# Modified sysupgrade stage2.
#
# Normal operation:
#   platform_do_upgrade "$IMAGE"
#
# Current-slot operation:
#   UPGRADE_OPT_USE_CURR_PART=1
#
# In current-slot mode we bypass the EA6350v3
# linksys_get_target_firmware() inactive-slot selection
# and explicitly select the currently active partitions.
#


. /lib/functions.sh

include /lib/upgrade


v "Performing system upgrade..."


#
# ============================================================
# CURRENT-SLOT UPGRADE
# ============================================================
#

if [ "$UPGRADE_OPT_USE_CURR_PART" = "1" ]; then

	echo
	echo "========================================"
	echo " EA6350v3 CURRENT-SLOT UPGRADE"
	echo "========================================"
	echo

	#
	# Verify board.
	#

	BOARD="$(board_name)"

	[ "$BOARD" = "linksys,ea6350v3" ] || {
		echo "ERROR: current-slot upgrade is supported only"
		echo "       on Linksys EA6350v3"
		exit 1
	}


	#
	# Verify image.
	#

	[ -n "$IMAGE" ] || {
		echo "ERROR: firmware image is not specified"
		exit 1
	}

	[ -f "$IMAGE" ] || {
		echo "ERROR: firmware image does not exist:"
		echo "       $IMAGE"
		exit 1
	}


	#
	# Current-slot mode accepts only an OpenWrt
	# sysupgrade image.
	#
	# 0x73797375 = "sysu"
	#

	magic_long="$(get_magic_long "$IMAGE")"

	if [ "$magic_long" != "73797375" ]; then

		echo "ERROR: current-slot upgrade requires"
		echo "       an OpenWrt sysupgrade image"
		echo
		echo "Image magic: $magic_long"

		exit 1

	fi


	#
	# Determine currently active firmware slot.
	#

	boot_part="$(fw_printenv -n boot_part 2>/dev/null | \
		head -n1)"


	case "$boot_part" in

		1)

			#
			# CURRENT SLOT = primary
			#

			CI_KERNPART="kernel"
			CI_UBIPART="rootfs"
			CI_ROOTPART="rootfs"

			;;

		2)

			#
			# CURRENT SLOT = alternate
			#

			CI_KERNPART="alt_kernel"
			CI_UBIPART="alt_rootfs"
			CI_ROOTPART="alt_rootfs"

			;;

		*)

			echo "ERROR: cannot determine current boot_part:"
			echo "       $boot_part"

			exit 1

			;;

	esac


	#
	# Export variables consumed by nand.sh.
	#

	export CI_KERNPART
	export CI_UBIPART
	export CI_ROOTPART


	#
	# Display target.
	#

	echo "Board: $BOARD"
	echo "Current boot_part: $boot_part"
	echo
	echo "CURRENT kernel partition: $CI_KERNPART"
	echo "CURRENT UBI partition:    $CI_UBIPART"
	echo "CURRENT rootfs volume:    $CI_ROOTPART"
	echo
	echo "Firmware image: $IMAGE"
	echo

	echo "WARNING:"
	echo "The CURRENT firmware slot will be replaced."
	echo
	echo "boot_part will NOT be changed."
	echo

	sync


	#
	# IMPORTANT:
	#
	# Do NOT call platform_do_upgrade().
	#
	# On EA6350v3 it invokes linksys.sh, which changes
	# the target to the inactive slot.
	#
	# nand_do_upgrade() operates using our explicit
	# CI_KERNPART / CI_UBIPART / CI_ROOTPART values.
	#

	echo "Starting NAND upgrade of CURRENT slot..."
	echo

	nand_do_upgrade "$IMAGE"


	#
	# nand_do_upgrade() normally does not return because
	# nand_do_upgrade_success() reboots the router.
	#

	echo
	echo "ERROR: nand_do_upgrade returned unexpectedly"

	exit 1

fi


#
# ============================================================
# NORMAL UPGRADE
# ============================================================
#

if type 'platform_do_upgrade' >/dev/null 2>/dev/null; then

	platform_do_upgrade "$IMAGE"

else

	default_do_upgrade "$IMAGE"

fi


#
# Restore configuration for normal sysupgrade.
#

if [ -n "$UPGRADE_BACKUP" ] && \
	type 'platform_copy_config' >/dev/null 2>/dev/null; then

	platform_copy_config

fi


v "Upgrade completed"

sleep 1

v "Rebooting system..."

umount -a

reboot -f

sleep 5

echo b 2>/dev/null >/proc/sysrq-trigger